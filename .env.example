# Copia este archivo como .env y completa con tus datos reales
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=contraseña
DB_NAME=dmrepuestos

JWT_SECRET=cambia_esto_por_un_secreto_largo_y_unico
JWT_EXPIRES_IN=8h

PORT=3000

# Configuracion de email (notificacion al admin de nuevos pedidos)
# Para Gmail: usar un "App Password" (no tu contraseña normal de la cuenta),
# se genera desde la configuracion de seguridad de tu cuenta de Google.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM="DM Repuestos Agricolas <tu_correo@gmail.com>"
ADMIN_EMAIL=admin_del_negocio@gmail.com

# Datos del primer usuario administrador (usado por AdminBootstrapService).
# Cambia la contraseña despues de tu primer login por seguridad.
ADMIN_SEED_NAME=Administrator
ADMIN_SEED_PASSWORD=CambiarEsta123
